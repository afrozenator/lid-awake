#!/bin/bash
set -euo pipefail
app_binary="$HOME/Applications/Lid Awake.app/Contents/MacOS/LidAwake"
case "${1:-status}" in
  on|enable) exec "$app_binary" --enable ;;
  off|disable) exec "$app_binary" --disable ;;
  status) exec "$app_binary" --status ;;
  open) exec /usr/bin/open "$HOME/Applications/Lid Awake.app" ;;
  *) printf 'Usage: %s {enable|disable|status|open}\n' "$0" >&2; exit 1 ;;
esac
